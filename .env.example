# ===== Lotten environment variables =====
# Copy this file to `.env` and fill in real values, then run `npm run build`.

# --- Supabase ---
# Project URL (Settings > API), e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon/public key (Settings > API) — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key (Settings > API) — SERVER ONLY, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (product image storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=            # e.g. https://pub-xxx.r2.dev
R2_BUCKET_NAME=

# --- Meilisearch (site search) ---
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=

# --- Pricing ---
USD_TO_MYR_RATE=          # e.g. 4.7
